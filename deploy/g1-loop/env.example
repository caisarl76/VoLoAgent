# Copy to .env next to compose.yaml. The build block is needed only where the image is built.

# --- the VLM's served name; the loop runner's --vlm-model must match ---
VLM_MODEL=qwen3-vl-4b

# --- build: weight sources on this workstation, baked into the image ---
VLM_HUB_REPO=/home/jihun/snap/alacritty/common/.cache/huggingface/hub/models--Qwen--Qwen3-VL-4B-Instruct
VLM_REVISION=ebb281ec70b05090aa6165b016eac8ec08e71b17
LEROBOT_DIR=/home/jihun/work/lerobot
POLICY_CKPT_DIR=/mnt/data/jihun/g1_models/wbt_groot_handover261015_he_full/pretrained_model
POLICY_HUB_DIR=/home/jihun/.cache/huggingface/hub

# --- run ---
VLM_GPU=0
VLM_PORT=8301
VLM_MIN_FREE_GB=9
POLICY_GPU=1
POLICY_PORT=5571

