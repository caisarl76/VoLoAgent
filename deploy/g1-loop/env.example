# Copy to .env next to compose.yaml. Each host only needs its own block (and the shared one).

# --- shared: the VLM's served name, which the runner sends ---
VLM_MODEL=qwen3-vl-4b

# --- workstation build: weight sources, baked into the images ---
VLM_HUB_REPO=/home/jihun/snap/alacritty/common/.cache/huggingface/hub/models--Qwen--Qwen3-VL-4B-Instruct
VLM_REVISION=ebb281ec70b05090aa6165b016eac8ec08e71b17
LEROBOT_DIR=/home/jihun/work/lerobot
POLICY_CKPT_DIR=/mnt/data/jihun/g1_models/wbt_groot_handover261015_he_full/pretrained_model
POLICY_HUB_DIR=/home/jihun/.cache/huggingface/hub

# --- workstation run ---
VLM_GPU=0
VLM_PORT=8301
VLM_MIN_FREE_GB=9
POLICY_GPU=1
POLICY_PORT=5571

# --- PC2 (runner) ---
LOOP_DIR=/home/unitree/GR00T-WholeBodyControl-loop-20261026
PROFILE=session-profile.yaml
HARNESS_ENDPOINT=ipc:///tmp/volo-g1-harness.sock
VLM_BASE_URL=http://192.168.0.62:8301/v1
